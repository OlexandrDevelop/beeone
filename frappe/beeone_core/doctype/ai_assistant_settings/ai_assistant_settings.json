{
  "creation": "2026-11-25",
  "description": "The AI assistant: the model provider, the limits and what the assistant may read",
  "doctype": "DocType",
  "document_type": "Setup",
  "engine": "InnoDB",
  "field_order": [
    "enabled",
    "provider",
    "model",
    "api_key",
    "base_url",
    "column_break_model",
    "status_html",
    "section_limits",
    "daily_limit",
    "max_steps",
    "max_answer_tokens",
    "column_break_limits",
    "cache_help_answers",
    "section_privacy",
    "allow_data",
    "mask_personal_data",
    "column_break_privacy",
    "log_retention_days"
  ],
  "fields": [
    {
      "default": "0",
      "description": "Without a model the assistant still finds help pages and runs the checks",
      "fieldname": "enabled",
      "fieldtype": "Check",
      "label": "Use an AI model"
    },
    {
      "default": "Gemini",
      "fieldname": "provider",
      "fieldtype": "Select",
      "label": "Provider",
      "options": "Gemini\nOpenAI compatible"
    },
    {
      "default": "gemini-flash-latest",
      "description": "For example gemini-flash-latest or gemini-2.5-flash; for a local server the name of its model",
      "fieldname": "model",
      "fieldtype": "Data",
      "label": "Model"
    },
    {
      "fieldname": "api_key",
      "fieldtype": "Password",
      "label": "API Key",
      "length": 255
    },
    {
      "depends_on": "eval:doc.provider==='OpenAI compatible'",
      "description": "For example http://ollama:11434/v1 or https://openrouter.ai/api/v1",
      "fieldname": "base_url",
      "fieldtype": "Data",
      "label": "Server Address"
    },
    {
      "fieldname": "column_break_model",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "status_html",
      "fieldtype": "HTML",
      "label": "Status"
    },
    {
      "fieldname": "section_limits",
      "fieldtype": "Section Break",
      "label": "Limits"
    },
    {
      "default": "30",
      "description": "Questions to the model per user per day; 0 means no limit",
      "fieldname": "daily_limit",
      "fieldtype": "Int",
      "label": "Questions per User per Day",
      "non_negative": 1
    },
    {
      "default": "5",
      "description": "Calls of the model for one question (each call of a tool takes one more)",
      "fieldname": "max_steps",
      "fieldtype": "Int",
      "label": "Model Calls per Question",
      "non_negative": 1
    },
    {
      "default": "2048",
      "fieldname": "max_answer_tokens",
      "fieldtype": "Int",
      "label": "Answer Length, Tokens",
      "non_negative": 1
    },
    {
      "fieldname": "column_break_limits",
      "fieldtype": "Column Break"
    },
    {
      "default": "1",
      "description": "The same question about using the program is answered from the cache for a day: it saves the quota",
      "fieldname": "cache_help_answers",
      "fieldtype": "Check",
      "label": "Cache Answers about Using the Program"
    },
    {
      "fieldname": "section_privacy",
      "fieldtype": "Section Break",
      "label": "Data and Privacy"
    },
    {
      "default": "1",
      "description": "The model may read documents, lists and reports (always with the rights of the user who asks). Off: help pages only",
      "fieldname": "allow_data",
      "fieldtype": "Check",
      "label": "The Assistant May Read the Data"
    },
    {
      "default": "1",
      "description": "Names of people, tax numbers, phones, e-mails and bank accounts are replaced with tokens before they are sent to the model; the user sees the real values",
      "fieldname": "mask_personal_data",
      "fieldtype": "Check",
      "label": "Hide Personal Data from the Model"
    },
    {
      "fieldname": "column_break_privacy",
      "fieldtype": "Column Break"
    },
    {
      "default": "90",
      "fieldname": "log_retention_days",
      "fieldtype": "Int",
      "label": "Keep the Log, Days",
      "non_negative": 1
    }
  ],
  "issingle": 1,
  "links": [],
  "modified": "2026-11-25",
  "modified_by": "Administrator",
  "module": "Beeone Core",
  "name": "AI Assistant Settings",
  "owner": "Administrator",
  "permissions": [
    {
      "create": 1,
      "delete": 1,
      "read": 1,
      "role": "System Manager",
      "write": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "states": [],
  "track_changes": 1
}
